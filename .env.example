# Run setup.ps1 to create .env with a random lab access code. Keep .env private.
MOUSECAM_ACCESS_CODE=
MOUSECAM_SIMULATED=false
# Blank discovers PATH, then ~/Downloads/mousecam-ffmpeg/**/ffmpeg.exe
MOUSECAM_FFMPEG=
MOUSECAM_CAMERA_URL=tcp://192.168.77.2:8888
MOUSECAM_CAPTURE_DIR=captures
MOUSECAM_HOST=0.0.0.0
MOUSECAM_PORT=8080
MOUSECAM_THREADS=24
MOUSECAM_SESSION_SECONDS=28800
MOUSECAM_MIN_FREE_MB=512
MOUSECAM_STALE_SECONDS=3
MOUSECAM_RECONNECT_ATTEMPTS=5
# Exact comma-separated origins only; empty disables cross-origin access.
MOUSECAM_ALLOWED_ORIGINS=
